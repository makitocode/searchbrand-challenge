# Database (Supabase or Local PostgreSQL)
# For local development with Docker:
DATABASE_URL=postgresql://searchbrand:searchbrand_dev_password@localhost:5434/searchbrand

# For Supabase (Production):
# Get your URL from: Settings → API → Project URL
# Get your keys from: Settings → API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_your-publishable-key-here

# Optional: For privileged server operations
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key-here

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=sk-proj-xxx
OPENAI_MODEL=gpt-4

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this

# App Configuration
PORT=3000
NODE_ENV=development

# Optional: External APIs
SERP_API_KEY=your-serpapi-key-optional
