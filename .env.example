# Database (Supabase or Local PostgreSQL)
# For local development with Docker: postgresql://searchbrand:searchbrand_dev_password@localhost:5434/searchbrand
# For Supabase: Use SUPABASE_URL and SUPABASE_KEY
DATABASE_URL=postgresql://searchbrand:searchbrand_dev_password@localhost:5434/searchbrand
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# LLM APIs
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=sk-proj-xxx
OPENAI_MODEL=gpt-4

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this

# App Configuration
PORT=3000
NODE_ENV=development

# Optional: External APIs
SERP_API_KEY=your-serpapi-key-optional
